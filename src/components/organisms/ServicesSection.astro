---
import { services } from '@data/site.data';
import { whatsappUrl } from '@utils/whatsapp';
---

<section class="section services" id="servicios">
  <div class="container">
    <header class="section-heading section-heading--split" data-reveal>
      <div>
        <p class="eyebrow">01 / El spark menu</p>
        <h2>El toque que hace<br />la <span>diferencia.</span></h2>
      </div>
      <p>Elige una estación o combina servicios. Adaptamos el ritmo y los looks al tipo de evento.</p>
    </header>
    <div class="service-grid">
      {services.map((service) => (
        <article class:list={['service-card', `service-card--${service.tone}`]} data-reveal>
          <span class="service-card__number">{service.number}</span>
          <div class="service-card__image">
            <img src={service.image} alt={service.alt} width="640" height="640" loading="lazy" decoding="async" />
          </div>
          <div class="service-card__body">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <a href={whatsappUrl(`Hola MechitaSparks, quiero cotizar ${service.title} para mi evento.`)} target="_blank" rel="noopener noreferrer">
              Cotizar servicio
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
